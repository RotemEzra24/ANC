#include <SPI.h>

// Pins
const int CS[4]  = {5, 19, 21, 22};      // MCP41010 chip selects, ch1-ch4
const int ADC[4] = {34, 35, 32, 33};     // reference mics, ch1-ch4
#define ADC_ERR  36                       // error mic (VP)

// Parameters
#define GAIN_BASE    180     // starting gain
#define GAIN_MAX     220     // gain ceiling
#define GAIN_STEP    3       // hill-climb step
#define ERR_ALPHA    0.25    // error smoothing
#define FB_RATIO     2.0     // feedback = 2x jump over running average
#define FB_MUTE_MS   2000    // mute time after feedback
#define RAMP_STEP    5       // ramp back speed
#define UPDATE_MS    150
#define FAST_ALPHA   0.3
#define SETTLE_MS    5000    // baseline measurement with system on

// State
float chFast[4]   = {0,0,0,0};
int   lastSent[4] = {-1,-1,-1,-1};
unsigned long muteUntil[4] = {0,0,0,0};
int   chGain[4]   = {0,0,0,0};
int   gainGlobal  = 0;
int   direction   = +1;
float errSmooth   = 0, errPrev = 0;
bool  armed       = false;
bool  protectOn   = true;

// Write gain to one pot, only if the value changed
void setGain(int ch, int val) {
  val = constrain(val, 0, 255);
  if (val == lastSent[ch]) return;
  digitalWrite(CS[ch], LOW);
  delayMicroseconds(10);
  SPI.transfer(0x11);
  SPI.transfer(255 - val);                // pots are wired inverted
  delayMicroseconds(10);
  digitalWrite(CS[ch], HIGH);
  lastSent[ch] = val;
}

// Peak to peak amplitude over 100 samples
int amp(int pin) {
  int mn = 4095, mx = 0;
  for (int i = 0; i < 100; i++) {
    int v = analogRead(pin);
    if (v < mn) mn = v;
    if (v > mx) mx = v;
    delayMicroseconds(60);
  }
  return mx - mn;
}

void setup() {
  Serial.begin(115200);
  analogReadResolution(12);
  for (int i = 0; i < 4; i++) { pinMode(CS[i], OUTPUT); digitalWrite(CS[i], HIGH); }
  delay(100);
  SPI.begin(18, -1, 23, -1);
  SPI.beginTransaction(SPISettings(250000, MSBFIRST, SPI_MODE0));
  delay(100);
  for (int i = 0; i < 4; i++) setGain(i, 0);

  // Ramp up to working gain
  for (int g = 0; g <= GAIN_BASE; g += RAMP_STEP) {
    for (int i = 0; i < 4; i++) setGain(i, g);
    delay(60);
  }
  gainGlobal = GAIN_BASE;
  for (int i = 0; i < 4; i++) chGain[i] = GAIN_BASE;

  // Measure baseline while the system is running
  unsigned long t0 = millis();
  while (millis() - t0 < SETTLE_MS) {
    for (int i = 0; i < 4; i++) {
      int a = amp(ADC[i]);
      chFast[i] = (chFast[i] == 0) ? a : chFast[i] * 0.9 + a * 0.1;
    }
    int e = amp(ADC_ERR);
    errSmooth = (errSmooth == 0) ? e : errSmooth * 0.9 + e * 0.1;
  }
  errPrev = errSmooth;
  armed = true;
}

void loop() {
  unsigned long now = millis();
  int a[4];

  // Read mics and check for feedback on each channel
  for (int i = 0; i < 4; i++) {
    a[i] = amp(ADC[i]);

    if (protectOn && armed && a[i] > chFast[i] * FB_RATIO && now > muteUntil[i]) {
      muteUntil[i] = now + FB_MUTE_MS;
      chGain[i] = 0;
    }

    // Update average only at full gain, not while muted or ramping
    if (now > muteUntil[i] && chGain[i] >= gainGlobal)
      chFast[i] = chFast[i] * (1.0 - FAST_ALPHA) + a[i] * FAST_ALPHA;
  }

  // Hill-climb on shared gain using the error mic
  int e = amp(ADC_ERR);
  errSmooth = errSmooth * (1.0 - ERR_ALPHA) + e * ERR_ALPHA;
  if (errSmooth > errPrev * 1.02) direction = -direction;
  errPrev = errSmooth;
  gainGlobal = constrain(gainGlobal + direction * GAIN_STEP, 0, GAIN_MAX);

  // Apply gain per channel (mute, ramp back, or follow shared gain)
  for (int i = 0; i < 4; i++) {
    if (now < muteUntil[i])            chGain[i] = 0;
    else if (chGain[i] < gainGlobal)   chGain[i] = min(chGain[i] + RAMP_STEP, gainGlobal);
    else                               chGain[i] = gainGlobal;
    setGain(i, chGain[i]);
  }

  // Serial Plotter output
  for (int i = 0; i < 4; i++) {
    Serial.print("a"); Serial.print(i+1); Serial.print(":"); Serial.print(a[i]); Serial.print(",");
  }
  for (int i = 0; i < 4; i++) {
    Serial.print("g"); Serial.print(i+1); Serial.print(":"); Serial.print(chGain[i]); Serial.print(",");
  }
  Serial.print("err:"); Serial.print((int)errSmooth);
  Serial.print(",G:");  Serial.println(gainGlobal);

  // Send 'p' to toggle feedback protection
  if (Serial.available()) {
    char c = Serial.read();
    while (Serial.available()) Serial.read();
    if (c == 'p') {
      protectOn = !protectOn;
      if (protectOn) for (int i = 0; i < 4; i++) muteUntil[i] = 0;
    }
  }

  delay(UPDATE_MS);
}
